generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id      String    @id
  email   String    @unique
  role    UserRoles
  version Int       @default(0)

  encryptedEmail  String? @unique
  emailBlindIndex String? @unique

  isActive  Boolean @default(true)
  isBlocked Boolean @default(false)
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerProfile CustomerProfile?
  sellerProfile   SellerProfile?
  adminProfile    AdminProfile?

  @@index([email])
  @@index([emailBlindIndex])
  @@index([isActive, role])
  @@index([isBlocked, isActive])
  @@index([isDeleted])
  @@map("users")
}

model CustomerProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  firstName   String
  lastName    String
  phone       String?
  avatar      String?
  dateOfBirth DateTime?

  shippingAddresses ShippingAddress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model ShippingAddress {
  id String @id @default(uuid())

  recipientName String
  street        String
  apartment     String?
  city          String
  state         String
  postalCode    String
  country       String

  isDefault Boolean @default(false)
  label     String?

  profileId String
  profile   CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@index([isDefault])
  @@map("shipping_addresses")
}

model SellerProfile {
  id        String  @id @default(uuid())
  userId    String  @unique
  firstName String
  lastName  String
  phone     String?
  avatar    String?

  shopName    String       @unique
  shopEmail   String
  shopPhone   String
  shopAddress ShopAddress?

  stripeConnectId    String? @unique
  onboardingComplete Boolean @default(false)

  commissionRate Float @default(10.0)

  totalProducts Int   @default(0)
  salesCount    Int   @default(0)
  totalRevenue  Float @default(0)
  rating        Float @default(0)
  reviewCount   Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shopName])
  @@map("seller_profiles")
}

model ShopAddress {
  id         String @id @default(uuid())
  street     String
  city       String
  state      String
  postalCode String
  country    String

  lat Float?
  lng Float?

  sellerProfileId String        @unique
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([country])
  @@map("shop_addresses")
}

model AdminProfile {
  id        String  @id @default(uuid())
  userId    String  @unique
  firstName String
  lastName  String
  phone     String?
  avatar    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model AuditLog {
  id         String  @id @default(uuid())
  actorId    String
  action     String
  targetId   String
  targetType String
  oldValues  Json?
  newValues  Json?
  diff       Json?
  ipAddress  String?
  userAgent  String?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([targetId, targetType])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id          String  @id @default(uuid())
  aggregateId String
  eventType   String
  payload     Json
  traceparent String?

  status      OutboxStatus @default(PENDING)
  retryCount  Int          @default(0)
  maxRetries  Int          @default(5)
  lastError   String?
  lockedAt    DateTime?
  lockedBy    String?
  processedAt DateTime?
  createdAt   DateTime     @default(now())

  @@index([status, createdAt])
  @@index([status, lockedAt])
  @@index([aggregateId])
  @@map("outbox_events")
}

model IdempotencyRecord {
  id                 String   @id
  key                String   @unique
  responseStatusCode Int
  responseBody       Json?
  expiresAt          DateTime

  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("idempotency_records")
}

model EncryptionKey {
  id           String    @id @default(uuid())
  userId       String    @unique
  keyId        String    @unique
  encryptedKey String
  algorithm    String    @default("aes-256-gcm")
  createdAt    DateTime  @default(now())
  destroyedAt  DateTime?

  @@index([userId])
  @@index([keyId])
  @@map("encryption_keys")
}

// ─── Enums ───

enum UserRoles {
  SUPER_ADMIN
  ADMIN
  SELLER
  CUSTOMER
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  DEAD
}
