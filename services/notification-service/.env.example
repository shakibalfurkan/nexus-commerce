# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
SERVICE_NAME=notification-service
PORT=5002

# ─── PostgreSQL (Neon / Aiven) ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/nexus_notifications

# ─── Kafka (Aiven Cloud Free Tier) ──────────────────────────────────────────
KAFKA_BROKER=
KAFKA_USERNAME=
KAFKA_PASSWORD=

# ─── Redis (Upstash Free Tier — shared instance, strict namespacing) ────────
REDIS_DATABASE_URL=rediss://default:password@host:6379

# ─── Rate Limiting (sliding window per recipient) ─────────────────────────
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_MS=3600000

# ─── Resilience (backoff + circuit breaker) ───────────────────────────────
BACKOFF_BASE_MS=1000
BACKOFF_MAX_MS=30000
MAX_ATTEMPTS=3
CB_FAILURE_THRESHOLD=5
CB_RESET_TIMEOUT_MS=30000

# ─── Resend (transactional email HTTP API) ─────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@yourdomain.com
RESEND_TIMEOUT_MS=10000
