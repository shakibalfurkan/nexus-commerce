generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model NotificationLog {
  id                String             @id @default(uuid())
  /// Idempotency key — the Kafka envelope's per-event `aggregateId` (no `eventId` exists on the wire).
  eventId           String             @unique
  eventType         String
  recipient         String
  subject           String?
  /// Raw event payload snapshot — enables DLQ re-drive and debugging without the original Kafka event.
  payloadSnapshot   Json?
  status            NotificationStatus @default(PENDING)
  attemptCount      Int                @default(0)
  maxRetries        Int                @default(3)
  lastError         String?
  /// Provider's message ID (e.g. Resend `id` field) — stored for observability and audit trails.
  providerMessageId String?
  /// Timestamp of the last send attempt — used for backoff calculations and SLA monitoring.
  lastAttemptAt     DateTime?
  /// When the next retry should fire — enables scheduled re-drive queries.
  nextRetryAt       DateTime?
  /// W3C traceparent propagated from Kafka message headers — enables distributed trace continuity.
  traceparent       String?
  /// Logical correlation ID for the causal chain (falls back to `aggregateId` when absent).
  correlationId     String?
  /// Causation ID — the event/command that directly caused this notification (optional, for deeper tracing).
  causationId       String?
  processedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([status, nextRetryAt])
  @@index([recipient, createdAt])
  @@index([eventType])
  @@map("notification_logs")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  DLQ
}
