generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id      String      @id
  email   String      @unique
  role    UserRoles[]
  version Int         @default(0)

  isActive  Boolean @default(true)
  isBlocked Boolean @default(false)
  isDeleted Boolean @default(false)

  blockedAt    DateTime?
  blockReason  String?
  blockedUntil DateTime?

  deletedAt        DateTime?
  canReactivate    Boolean       @default(true)
  deletionType     DeletionType?
  reactivateWithin DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerProfile CustomerProfile?
  sellerProfile   SellerProfile?
  adminProfile    AdminProfile?

  @@index([email])
  @@index([isActive, role])
  @@index([isBlocked, isActive])
  @@index([isDeleted])
  @@map("users")
}

model CustomerProfile {
  id     String @id @default(uuid())
  userId String @unique

  // ─── Identity ───
  firstName       String
  lastName        String
  phone           String?
  phoneVerifiedAt DateTime?
  avatar          String?
  dateOfBirth     DateTime?

  // ─── Localization ───
  locale            String @default("en-US")
  timezone          String @default("UTC")
  preferredCurrency String @default("USD")

  // ─── Consent & legal ───
  termsAcceptedAt  DateTime?
  termsVersion     String?
  marketingOptIn   Boolean   @default(false)
  marketingOptInAt DateTime?

  // ─── Attribution ───
  signupSource   String?
  referralCode   String  @unique
  referredByCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shippingAddresses ShippingAddress[]

  stats CustomerStats?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("customer_profiles")
}

model ShippingAddress {
  id String @id @default(uuid())

  recipientName String
  street        String
  apartment     String?
  city          String
  state         String
  postalCode    String
  country       String

  isDefault Boolean @default(false)
  label     String?

  profileId String
  profile   CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@index([profileId, isDefault])
  @@map("shipping_addresses")
}

model CustomerStats {
  customerProfileId String @id

  lifetimeValue Decimal   @default(0) @db.Decimal(12, 2)
  orderCount    Int       @default(0)
  lastOrderAt   DateTime?

  loyaltyPoints Int          @default(0)
  loyaltyTier   CustomerTier @default(BRONZE)
  updatedAt     DateTime     @updatedAt

  profile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  @@map("customer_stats")
}

